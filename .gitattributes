# Normalize text files to LF in the repository and in every checkout: generated outputs (data/*.json, data/catalog.js,
# index.html) are compared byte-for-byte by --check, so a CRLF checkout must not make them look stale.
* text=auto eol=lf
*.html linguist-language=javascript

# Preserve downloaded media bytes exactly, including PDFs that look textual.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary

# Never convert line endings of files whose exact bytes are pinned, whatever core.autocrlf or core.eol say:
# every archived asset (manifests record its SHA-256), license texts, vendored code and all test fixtures
# (fixture manifests record the hashes of fixture media and are regenerated byte-for-byte).
/LICENSE -text
/licenses/*.txt -text
/src/vendor/** -text
/assets/** -text
/tests/fixtures/** -text
/tests/fixtures/**/*.png binary
/tests/fixtures/**/*.jpg binary
/tests/fixtures/**/*.webp binary
/tests/fixtures/**/*.gif binary
/tests/fixtures/**/*.pdf binary
